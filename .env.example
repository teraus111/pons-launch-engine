# --- Connection ----------------------------------------------------------
# Use matching HTTP and WebSocket endpoints from Alchemy or another provider.
# The public Robinhood Chain HTTP endpoint is only a read fallback.
RPC_HTTP_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
RPC_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CHAIN_ID=4663
POLL_INTERVAL_MS=150

# --- Campaign files ------------------------------------------------------
CAMPAIGN_FILE=campaign.json
STRATEGIES_FILE=strategies.json
CREDENTIALS_FILE=credentials.json

# Required only for launch campaigns that use token.logoFile. Create a Pinata
# API key with public file-upload permission and paste its JWT into your .env.
PINATA_JWT=YOUR_PINATA_JWT

# --- Durable state -------------------------------------------------------
STATE_DB_FILE=state/pons.db

# --- Operation -----------------------------------------------------------
# DRY_RUN=true prepares and simulates plans without broadcasting transactions.
DRY_RUN=false
LOG_LEVEL=info
POSITION_TICK_MS=2000
ENTRY_MAX_WAIT_MS=10000
ENTRY_POLL_MS=50
GAS_LIMIT_MULTIPLIER=1.4

# Official Robinhood Chain Uniswap v4 addresses are built in. Set these only
# when deliberately routing through different compatible deployments.
V4_ROUTER_ADDRESS=
V4_QUOTER_ADDRESS=
